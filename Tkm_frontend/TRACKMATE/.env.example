# ==========================
# 🔑 Google Maps API Keys
# ==========================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/

google_translate_api_key=YOUR_GOOGLE_TRANSLATE_API_KEY_HERE
places_api_key=YOUR_GOOGLE_PLACES_API_KEY_HERE
directions_api_key=YOUR_GOOGLE_DIRECTIONS_API_KEY_HERE
geocoding_api_key=YOUR_GOOGLE_GEOCODING_API_KEY_HERE

# ==========================
# 🌐 Backend API Configuration
# ==========================

API_BASE_URL=http://your-backend-server.com/api

# ==========================
# 🔐 Authentication API Endpoints
# ==========================

LOGIN_URL=http://your-backend-server.com/api/auth/login/
SIGNUP_URL=http://your-backend-server.com/api/auth/signup/
FORGOT_PASSWORD_URL=http://your-backend-server.com/api/auth/forgot-password/
RESET_PASSWORD_URL=http://your-backend-server.com/api/auth/reset-password/
LOGOUT_URL=http://your-backend-server.com/api/auth/logout/

# ==========================
# 📱 OTP Configuration
# ==========================

VERIFY_PHONE_OTP_URL=http://your-backend-server.com/api/auth/verify/
SEND_PHONE_OTP_URL=http://your-backend-server.com/api/auth/signup/
