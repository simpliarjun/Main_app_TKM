# ==========================
# 🔐 Django Production Configuration (Template)
# ==========================
DJANGO_SECRET_KEY=your-production-secret-key-change-me
DJANGO_DEBUG=False

# 📧 Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# 🗄️ PostgreSQL Database
DB_NAME=trackmate_db
DB_USER=trackmate_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# 🗺️ Google Maps API Keys
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_GEOCODING_API_KEY=YOUR_GOOGLE_GEOCODING_API_KEY_HERE
GOOGLE_DIRECTIONS_API_KEY=YOUR_GOOGLE_DIRECTIONS_API_KEY_HERE
